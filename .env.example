# =============================================================================
# transcriber-local -- Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores. NUNCA faca commit do .env.
# =============================================================================

# --- LLM para Resumo (Gemini) ---
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Usado antes de configurar favoritos na interface.
# Depois, o padrão salvo em Gerenciar modelos tem prioridade.
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite

# --- Whisper (STT Local) ---
# Tamanho do modelo: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# Idioma de transcricao (codigo ISO 639-1)
WHISPER_LANGUAGE=pt

# --- Captura de Audio ---
# Deixe vazio para usar os dispositivos padrao do sistema
AUDIO_MIC_INDEX=
AUDIO_SYS_INDEX=

# Duracao de cada chunk de audio em segundos
AUDIO_CHUNK_DURATION=10.0

# Sobreposicao entre chunks em segundos (para evitar perda de palavras)
AUDIO_CHUNK_OVERLAP=2.0
